# ─── Backend API URL ──────────────────────────────────────────────────────────
# URL of your NestJS backend
# Local: http://localhost:3001
# Production (Render): https://your-api.onrender.com
NEXT_PUBLIC_API_URL="http://localhost:3001"

# ─── NextAuth ─────────────────────────────────────────────────────────────────
# The canonical URL of your Next.js frontend
NEXTAUTH_URL="http://localhost:3000"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET="REPLACE_WITH_32_CHAR_RANDOM_SECRET"

# ─── Google OAuth (optional) ────────────────────────────────────────────────────
# Get from: https://console.cloud.google.com
# 1. Create a project → APIs & Services → Credentials → Create OAuth 2.0 Client
# 2. Application type: Web Application
# 3. Authorized redirect URIs: http://localhost:3000/api/auth/callback/google
# 4. Copy Client ID and Client Secret
# Leave blank to disable Google sign-in
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
