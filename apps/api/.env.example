# ─── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string
# Local: postgresql://postgres:password@localhost:5432/emailplatform
# Supabase: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# Render: copy from your Render PostgreSQL dashboard
DATABASE_URL="postgresql://postgres:password@localhost:5432/emailplatform"

# ─── Redis ─────────────────────────────────────────────────────────────────────
# BullMQ queue connection
# Local: redis://localhost:6379
# Upstash (production): rediss://default:[TOKEN]@[ENDPOINT].upstash.io:PORT
REDIS_URL="redis://localhost:6379"

# ─── JWT Authentication ─────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="REPLACE_WITH_32_CHAR_RANDOM_SECRET"

# ─── AES-256-GCM Encryption (for SendGrid API keys) ────────────────────────────
# CRITICAL: Must be exactly 64 hex characters (32 bytes)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WARNING: Changing this key will make existing encrypted API keys unreadable!
ENCRYPTION_KEY="REPLACE_WITH_64_HEX_CHAR_KEY"

# ─── Server ─────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── CORS ──────────────────────────────────────────────────────────────────────
# URL of your Next.js frontend
FRONTEND_URL="http://localhost:3000"

# ─── Google OAuth (optional) ────────────────────────────────────────────────────
# Get from: https://console.cloud.google.com > APIs & Services > Credentials
# Leave empty to disable Google OAuth
GOOGLE_CLIENT_ID=""
